{
  "openapi": "3.1.0",
  "info": {
    "title": "Moksha Entry API",
    "version": "0.1.0"
  },
  "paths": {
    "/form-config": {
      "get": {
        "summary": "Form Config",
        "description": "Everything the registration form needs that might change: consent wording, captcha key, limits.",
        "operationId": "form_config_form_config_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FormConfigOut"
                }
              }
            }
          }
        }
      }
    },
    "/colleges": {
      "get": {
        "summary": "List Colleges",
        "operationId": "list_colleges_colleges_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CollegeOut"
                  },
                  "type": "array",
                  "title": "Response List Colleges Colleges Get"
                }
              }
            }
          }
        }
      }
    },
    "/uploads/presign": {
      "post": {
        "summary": "Presign Upload",
        "operationId": "presign_upload_uploads_presign_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PresignIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PresignOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/registrations": {
      "post": {
        "summary": "Create Registration",
        "operationId": "create_registration_registrations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistrationIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/status/{token}": {
      "get": {
        "summary": "Get Status",
        "operationId": "get_status_status__token__get",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Token"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/status/{token}/reupload/presign": {
      "post": {
        "summary": "Presign Reupload",
        "operationId": "presign_reupload_status__token__reupload_presign_post",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Token"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PresignIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PresignOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/status/{token}/reupload": {
      "post": {
        "summary": "Reupload",
        "operationId": "reupload_status__token__reupload_post",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Token"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReuploadIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "summary": "Healthz",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CollegeOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "CollegeOut"
      },
      "FormConfigOut": {
        "properties": {
          "consent_version": {
            "type": "string",
            "title": "Consent Version"
          },
          "consent_entry_text": {
            "type": "string",
            "title": "Consent Entry Text"
          },
          "consent_dataset_text": {
            "type": "string",
            "title": "Consent Dataset Text"
          },
          "turnstile_site_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Turnstile Site Key"
          },
          "max_upload_bytes": {
            "type": "integer",
            "title": "Max Upload Bytes"
          },
          "allowed_content_types": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Allowed Content Types"
          },
          "min_image_long_side_px": {
            "type": "integer",
            "title": "Min Image Long Side Px"
          }
        },
        "type": "object",
        "required": [
          "consent_version",
          "consent_entry_text",
          "consent_dataset_text",
          "turnstile_site_key",
          "max_upload_bytes",
          "allowed_content_types",
          "min_image_long_side_px"
        ],
        "title": "FormConfigOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PresignIn": {
        "properties": {
          "content_type": {
            "type": "string",
            "title": "Content Type"
          },
          "size": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Size"
          }
        },
        "type": "object",
        "required": [
          "content_type",
          "size"
        ],
        "title": "PresignIn"
      },
      "PresignOut": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url"
          },
          "fields": {
            "additionalProperties": true,
            "type": "object",
            "title": "Fields"
          },
          "key": {
            "type": "string",
            "title": "Key"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In"
          }
        },
        "type": "object",
        "required": [
          "url",
          "fields",
          "key",
          "expires_in"
        ],
        "title": "PresignOut"
      },
      "RegistrationIn": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 2,
            "title": "Name"
          },
          "college_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "College Id"
          },
          "college_other": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "College Other"
          },
          "roll_no": {
            "type": "string",
            "maxLength": 40,
            "minLength": 2,
            "title": "Roll No"
          },
          "course": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ],
            "title": "Course"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          },
          "id_image_key": {
            "type": "string",
            "title": "Id Image Key"
          },
          "consent_entry": {
            "type": "boolean",
            "const": true,
            "title": "Consent Entry"
          },
          "consent_dataset": {
            "type": "boolean",
            "title": "Consent Dataset",
            "default": false
          },
          "consent_version": {
            "type": "string",
            "title": "Consent Version"
          },
          "captcha_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Captcha Token"
          }
        },
        "type": "object",
        "required": [
          "name",
          "roll_no",
          "email",
          "id_image_key",
          "consent_entry",
          "consent_version"
        ],
        "title": "RegistrationIn"
      },
      "RegistrationOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "status_url": {
            "type": "string",
            "title": "Status Url"
          },
          "status_token": {
            "type": "string",
            "title": "Status Token"
          }
        },
        "type": "object",
        "required": [
          "id",
          "status",
          "status_url",
          "status_token"
        ],
        "title": "RegistrationOut"
      },
      "ReuploadIn": {
        "properties": {
          "id_image_key": {
            "type": "string",
            "title": "Id Image Key"
          }
        },
        "type": "object",
        "required": [
          "id_image_key"
        ],
        "title": "ReuploadIn"
      },
      "StatusOut": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "college": {
            "type": "string",
            "title": "College"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Reasons"
          },
          "can_reupload": {
            "type": "boolean",
            "title": "Can Reupload"
          },
          "qr_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Qr Token"
          }
        },
        "type": "object",
        "required": [
          "name",
          "college",
          "status",
          "message",
          "reasons",
          "can_reupload"
        ],
        "title": "StatusOut"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}