# Copy to .env and fill in. Never commit .env.
ENV=dev
DATABASE_URL=postgresql+asyncpg://moksha:moksha@localhost:5432/moksha
REDIS_URL=redis://localhost:6379/0

# Storage (MinIO locally; real bucket in production)
S3_BUCKET=moksha-ids
S3_REGION=ap-south-1
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=
S3_ACCESS_KEY=moksha
S3_SECRET_KEY=moksha-secret

# Cloudflare Turnstile secret. Empty = captcha skipped (dev only!)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
RATE_LIMIT_PER_IP_PER_HOUR=20

# Bump whenever the consent wording on the form changes; the form must send the same value.
CONSENT_VERSION=2026-10-18.v1

# The website origin(s) that host the form. The storage bucket needs the same CORS origins.
CORS_ORIGINS=["http://localhost:3000"]
STATUS_URL_TEMPLATE=http://localhost:3000/status/{token}

# Worker (OCR pipeline)
FEST_DAY=2026-10-24          # cards valid only before this date are treated as expired
WORKER_CONCURRENCY=2         # jobs per worker process; run more processes (or replicas) to go faster
PHASH_MAX_DISTANCE=6         # how similar two card portraits must be to count as the same card

# From scripts/gen_keys.py. The signing key stays on the server only (worker). Never commit it.
# The public key is also compiled into the gate app: --dart-define=PASS_PUBLIC_KEY=...
PASS_SIGNING_KEY=
PASS_PUBLIC_KEY=

# Passes
EVENT_ID=moksha26            # must equal the gate app's EVENT_ID
EVENT_NAME=Moksha 2026
FEST_DAYS=1,2,3              # days every pass is valid for (the gate app checks today against this)
FEST_DAYS_LABEL=all fest days

# Staff and gates
ADMIN_TOKEN=                 # long random string; signs you in at /admin to create reviewers and gate phones
API_PUBLIC_URL=http://localhost:8000   # the API's public https URL; goes into the gate setup QR
REVIEW_CLAIM_MINUTES=10

# Email (any SMTP provider: Amazon SES, Brevo, Mailgun, Postmark...). Port 587 = STARTTLS, 465 = SSL.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=Moksha <passes@your-domain>
SMTP_REPLY_TO=
